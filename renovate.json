{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 7am on the first day of the month"],
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "groupName": "Android Gradle Plugin",
      "matchPackagePrefixes": ["com.android"],
      "matchManagers": ["gradle"]
    },
    {
      "groupName": "Kotlin",
      "matchPackagePrefixes": ["org.jetbrains.kotlin"],
      "matchManagers": ["gradle"]
    },
    {
      "groupName": "AndroidX",
      "matchPackagePrefixes": ["androidx."],
      "matchManagers": ["gradle"]
    },
    {
      "groupName": "MapLibre",
      "matchPackagePrefixes": ["org.maplibre"],
      "matchManagers": ["gradle"]
    },
    {
      "groupName": "Testing",
      "matchPackagePrefixes": ["junit", "androidx.test"],
      "matchManagers": ["gradle"]
    }
  ]
}